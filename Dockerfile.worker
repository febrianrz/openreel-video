FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium ffmpeg ca-certificates fonts-dejavu-core fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /worker
COPY worker/package*.json ./
RUN npm ci --omit=dev
COPY worker/*.mjs ./
ENV NODE_ENV=production CHROMIUM_PATH=/usr/bin/chromium PORT=8091
USER node
EXPOSE 8091
HEALTHCHECK --interval=30s --start-period=120s CMD node -e "fetch('http://127.0.0.1:8091/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
